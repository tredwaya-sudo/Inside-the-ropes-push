# HTTP
PORT=8787
HOST=0.0.0.0
DATABASE_PATH=./data/push.sqlite

# Clippd
CLIPPD_HOST=https://scoreboard.clippd.com
POLL_INTERVAL_MS=60000

# APNs (.p8 key from Apple Developer → Keys)
APNS_KEY_ID=
APNS_TEAM_ID=K95LALRF9A
APNS_BUNDLE_ID=com.insidetheropes.InsideTheRopes
# Prefer one of:
# APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
# APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_KEY_PATH=
APNS_KEY_P8=
# true = production gateway, false = sandbox
APNS_PRODUCTION=false

# Optional: skip APNs send (still diffs + logs) for local dry runs
APNS_DRY_RUN=false
